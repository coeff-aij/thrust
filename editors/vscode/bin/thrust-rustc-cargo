#!/bin/sh
# RUSTC for the extension's `cargo check`: runs the command of THRUST_VSCODE_COMMAND (its words
# separated by the unit separator, 0x1f) with cargo's arguments, then those of
# THRUST_VSCODE_ARGS (separated alike), for every crate and for cargo's queries of the compiler
# (`-vV`, `--print`). For each crate it
#
# - removes the report of an earlier check, THRUST_VSCODE_REPORT_DIR/<package>.<crate>.<crate
#   type>.jsonl, so a crate that fails to compile or is not reported leaves none;
# - for a crate of a package cargo was asked to check (CARGO_PRIMARY_PACKAGE), writes its JSON
#   report there; other crates (dependencies) run without a report;
# - sets THRUST_VERIFY_ONLY to THRUST_VSCODE_VERIFY_ONLY for the crate THRUST_VSCODE_VERIFY_CRATE
#   names (`<crate>.<crate type>`) only, so a run of one function of a binary leaves the
#   package's library whole;
# - records in the crate's dep-info, as `env-dep` lines as rustc does for `env!`, the variables
#   Thrust reads, the extension's (the command, its arguments, the selection, the identity of the
#   Thrust binary) and those THRUST_VSCODE_ENV_KEYS names, so that cargo checks the crate again
#   when one of them changes instead of keeping its earlier result.
set -eu
set -f

sep=$(printf '\037')

# The variables Thrust reads (`std::env::var` under src/ and thrust-macros/src/), and the
# extension's.
tracked="THRUST_CACHE_DIR THRUST_CACHE_SALT THRUST_CANDIDATE_ATOMS THRUST_CHECK_UINT_FACTS
THRUST_DEDUP_PRED_ARGS THRUST_ENUM_EXPANSION_DEPTH_LIMIT THRUST_FLAT_PRED_ARGS THRUST_INT_RANGE
THRUST_NO_INJECT_STD THRUST_OUTPUT_DIR THRUST_PER_INSTANCE_GENERICS THRUST_PREPROCESSOR
THRUST_PREPROCESSOR_ARGS THRUST_PREPROCESSOR_TIMEOUT_SECS THRUST_PRETTY_OUTPUT THRUST_REPORT
THRUST_REPORT_FORMAT THRUST_REPORT_ONLY THRUST_SOLVER THRUST_SOLVER_ARGS
THRUST_SOLVER_TIMEOUT_SECS THRUST_SPLIT THRUST_TRY_SPECS THRUST_VERIFY_ONLY
THRUST_VSCODE_COMMAND THRUST_VSCODE_ARGS THRUST_VSCODE_THRUST_ID THRUST_VSCODE_VERIFY_ONLY
THRUST_VSCODE_VERIFY_CRATE THRUST_VSCODE_ENV_KEYS"

# run [args...]: the command with the arguments and the extra arguments.
run() {
  IFS=$sep
  # shellcheck disable=SC2086
  set -- $THRUST_VSCODE_COMMAND "$@" ${THRUST_VSCODE_ARGS:-}
  unset IFS
  "$@"
}

# The value of the option `$1` in the arguments after it (`--out-dir x` or `--out-dir=x`).
option() {
  name=$1
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      "$name") [ $# -ge 2 ] && { printf '%s' "$2"; return; } ;;
      "$name"=*) printf '%s' "${1#"$name"=}"; return ;;
    esac
    shift
  done
}

# The value of the codegen option `-C $1=...`.
codegen() {
  name=$1
  shift
  previous=
  for arg in "$@"; do
    case $previous:$arg in
      -C:"$name"=*) printf '%s' "${arg#"$name"=}"; return ;;
    esac
    case $arg in
      -C"$name"=*) printf '%s' "${arg#-C"$name"=}"; return ;;
    esac
    previous=$arg
  done
}

# The value escaped as rustc escapes an `env-dep` value: `\`, newline and carriage return.
escape() {
  printf '%sx' "$1" | awk '
    { gsub(/\\/, "\\\\"); gsub(/\r/, "\\r"); printf "%s%s", (NR > 1 ? "\\n" : ""), $0 }
  ' | sed 's/x$//'
}

# Appends an `env-dep` line for each tracked variable to the dep-info file `$1`, if it exists.
record_env() {
  [ -f "$1" ] || return 0
  names="$tracked $(printf '%s' "${THRUST_VSCODE_ENV_KEYS:-}" | tr "$sep" ' ')"
  for var in $names; do
    case $var in
      '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
    esac
    if eval "[ -n \"\${$var+set}\" ]"; then
      eval "value=\$$var"
      printf '# env-dep:%s=%s\n' "$var" "$(escape "$value")" >> "$1"
    else
      printf '# env-dep:%s\n' "$var" >> "$1"
    fi
  done
}

if [ -z "${CARGO_CRATE_NAME:-}" ] || [ -z "${THRUST_VSCODE_REPORT_DIR:-}" ]; then
  run "$@"
  exit
fi

crate=$(option --crate-name "$@")
crate_type=$(option --crate-type "$@")
crate_type=${crate_type:-bin}
out_dir=$(option --out-dir "$@")
extra=$(codegen extra-filename "$@")
report="$THRUST_VSCODE_REPORT_DIR/${CARGO_PKG_NAME}.${crate}.${crate_type}.jsonl"
mkdir -p "$THRUST_VSCODE_REPORT_DIR"
rm -f "$report"

if [ -n "${CARGO_PRIMARY_PACKAGE:-}" ]; then
  THRUST_REPORT_FILE=$report
  export THRUST_REPORT_FILE
else
  unset THRUST_REPORT
fi
if [ -n "${THRUST_VSCODE_VERIFY_CRATE:-}" ]; then
  if [ "$THRUST_VSCODE_VERIFY_CRATE" = "$crate.$crate_type" ]; then
    THRUST_VERIFY_ONLY=${THRUST_VSCODE_VERIFY_ONLY:-}
    export THRUST_VERIFY_ONLY
  else
    unset THRUST_VERIFY_ONLY
  fi
fi

status=0
run "$@" || status=$?
record_env "$out_dir/$crate$extra.d"
exit $status
