#!/bin/bash

COAR_IMAGE=${COAR_IMAGE:-coar:latest}
COAR_CONFIG=${COAR_CONFIG:-./config/solver/pcsat_tbq_ar.json}

# Each container gets a fixed share of the machine (the limits coar-run uses), so that eight
# containers started by the test harness do not oversubscribe the cores: PCSat's validity checks
# run under wall-clock budgets, and a query that answers on an idle machine prints `timeout`
# when its Z3 is starved.
cpus=${THRUST_PCSAT_CPUS:-2}
memory=${THRUST_PCSAT_MEMORY:-8g}

smt2=$(mktemp -p . --suffix .smt2)
solver_out=$(mktemp)
trap 'rm -f "$smt2" "$solver_out"' EXIT
cp "$1" "$smt2"

# THRUST_PCSAT_LABEL (key=value), if set, labels the container, so that a caller can tell its own
# containers from those of other runs.
container=$(docker create --rm --cpus="$cpus" --memory="$memory" ${THRUST_PCSAT_LABEL:+--label "$THRUST_PCSAT_LABEL"} \
    -v "$PWD:/mnt" -w /root/coar "$COAR_IMAGE" \
    main.exe -c "$COAR_CONFIG" -p pcsp "/mnt/$smt2")
trap 'docker rm --force "$container" >/dev/null; exit 143' TERM

# needs `wait` to fire the `trap` above
docker start --attach "$container" > "$solver_out" &
wait $!
exit_code=$?

out=$(< "$solver_out")
echo "${out%,*}"
exit "$exit_code"
