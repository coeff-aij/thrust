#!/bin/bash

COAR_IMAGE=${COAR_IMAGE:-coar:latest}

# The query copy goes into a directory of its own outside the caller's working directory (the
# Thrust tree under the ui harness), so that a call killed before its cleanup leaves nothing there.
work=$(mktemp -d)
solver_out=$work/solver.out
trap 'rm -rf "$work"' EXIT
cp "$1" "$work/query.smt2"

container=$(docker create --rm -v "$work:/mnt" -w /root/coar "$COAR_IMAGE" \
    main.exe -c ./config/solver/spacer_pp.json -p pcsp /mnt/query.smt2)
trap 'docker rm --force "$container" >/dev/null; exit 143' TERM

# needs `wait` to fire the `trap` above
docker start --attach "$container" > "$solver_out" &
wait $!
exit_code=$?

out=$(< "$solver_out")
echo "${out%,*}"
exit "$exit_code"
